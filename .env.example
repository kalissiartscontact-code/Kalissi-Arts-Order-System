# ==============================================================================
# KALISSI ARTS - PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================

# Node Environment & Server Port
NODE_ENV=production
PORT=3000

# Administrator Passcode (Used to access the admin orders dashboard and settings)
# Default fallback is 'kalissi2026' if not defined
ADMIN_PASSCODE=your_secret_admin_passcode_here

# ------------------------------------------------------------------------------
# ZR EXPRESS LOGISTICS API (Algeria - https://api.zrexpress.app)
# Required to fetch stopdesk branches and create shipping parcels automatically
# ------------------------------------------------------------------------------
X_TENANT=your_zr_express_tenant_code
X_API_KEY=your_zr_express_api_key
ZR_API_BASE_URL=https://api.zrexpress.app

# ------------------------------------------------------------------------------
# CLOUDFLARE TURNSTILE (CAPTCHA / ANTI-ABUSE PROTECTION)
# Optional but recommended in production: Protects order submissions from bots
# ------------------------------------------------------------------------------
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key
VITE_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key





